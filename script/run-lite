#!/bin/bash
set -euo pipefail
cd -- "$(dirname "${BASH_SOURCE[0]}")/.."

CARGO_COMMAND=run
PROFILE_ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --release) PROFILE_ARGS=(--profile lite); shift ;;
        --build-only) CARGO_COMMAND=build; shift ;;
        --) shift; break ;;
        *) break ;;
    esac
done

CARGO_ARGS=("$CARGO_COMMAND" "${PROFILE_ARGS[@]}" --bin warp-lite --no-default-features --features warp_lite --locked)
if [[ "$CARGO_COMMAND" == run ]]; then
    CARGO_ARGS+=(-- "$@")
fi
exec cargo "${CARGO_ARGS[@]}"
