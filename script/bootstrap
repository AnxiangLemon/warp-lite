#!/bin/bash
set -euo pipefail
cd -- "$(dirname "${BASH_SOURCE[0]}")/.."
case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./script/windows/bootstrap.ps1 "$@" ;;
    Darwin) exec ./script/macos/bootstrap "$@" ;;
    Linux) exec ./script/linux/bootstrap "$@" ;;
    *) echo "Unsupported platform" >&2; exit 1 ;;
esac
